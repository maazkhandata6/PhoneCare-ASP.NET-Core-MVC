<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PhoneCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <nav class="navbar navbar-expand-lg container-fluid px-lg-5">
        <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-phone-fill"></i></span> phone<span>care</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Requests">Repair requests</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Services">Services & pricing</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Customers">Customers</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Brands">Phone catalog</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Payments">Payments</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Reports">Reports</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="Index">My dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Repair" asp-action="Create">Request repair</a></li>
                    }
                    <li class="nav-item user-pill"><i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")</li>
                    <li class="nav-item"><a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Logout">Sign out</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#services">Services</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                    <li class="nav-item"><a class="btn btn-brand btn-sm px-4" asp-controller="Account" asp-action="Register">Get started <i class="bi bi-arrow-up-right"></i></a></li>
                }
            </ul>
        </div>
    </nav>
</header>
<main>
    @if (TempData["Success"] != null) { <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div> }
    @RenderBody()
</main>
<footer class="footer"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>© @DateTime.Now.Year PhoneCare. Repair smarter.</span><span>Built with ASP.NET Core MVC · C# · SQL Server</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
