@model IEnumerable<Customer>
@{ViewData["Title"]="Customers";}
<div class="dashboard-shell"><div class="container"><div class="dash-heading"><div><div class="eyebrow">CUSTOMER DIRECTORY</div><h1>Customer <em>management.</em></h1><p class="muted">Search registered accounts.</p></div><a class="btn btn-outline-secondary rounded-pill" asp-action="Index">Dashboard</a></div><div class="panel"><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name, email or phone"/><button class="btn btn-dark">Search</button></form><div class="table-responsive"><table class="table"><thead><tr><th>NAME</th><th>EMAIL</th><th>PHONE</th><th>JOINED</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.FullName</td><td>@c.Email</td><td>@c.PhoneNumber</td><td>@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></div></div></div>