@{ViewData["Title"]="Reports";}
<div class="dashboard-shell"><div class="container"><div class="dash-heading"><div><div class="eyebrow">BUSINESS INTELLIGENCE</div><h1>Reports & <em>analytics.</em></h1><p class="muted">Repair workflow and payment summary.</p></div><a class="btn btn-outline-secondary rounded-pill" asp-action="Index">Dashboard</a></div><div class="row g-3"><div class="col-md-3"><div class="metric-card"><div>Total repairs</div><div class="metric-number">@ViewBag.Total</div></div></div><div class="col-md-3"><div class="metric-card metric-green"><div>Completed</div><div class="metric-number">@ViewBag.Completed</div></div></div><div class="col-md-3"><div class="metric-card metric-orange"><div>Open</div><div class="metric-number">@ViewBag.Open</div></div></div><div class="col-md-3"><div class="metric-card metric-dark"><div>Payments received</div><div class="metric-number compact">PKR @(((decimal)ViewBag.Paid).ToString("N0"))</div></div></div></div><div class="panel mt-4"><h4>Completion rate</h4><p class="muted">@(ViewBag.Total==0?0:Math.Round((double)ViewBag.Completed/(double)ViewBag.Total*100,1))% of submitted requests are marked completed.</p></div></div></div>