@model IEnumerable<RepairRequest>
@{ ViewData["Title"] = "Repair requests"; }
<div class="dashboard-shell"><div class="container"><div class="dash-heading"><div><div class="eyebrow">WORK QUEUE</div><h1>Repair <em>requests.</em></h1><p class="muted">Review customer submissions and keep every repair moving.</p></div><a class="btn btn-outline-secondary rounded-pill" asp-action="Index">Dashboard</a></div>
<div class="panel"><div class="panel-head"><div><h4>All requests</h4><p>Update status using the controls on each row.</p></div><form method="get"><select name="status" class="form-select form-select-sm" onchange="this.form.submit()"><option value="">All statuses</option>@foreach(var s in new[]{"Submitted","Diagnosing","Awaiting Approval","In Repair","Completed","Rejected"}){<option selected="@(ViewBag.Status as string == s)" value="@s">@s</option>}</select></form></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>REQUEST / CUSTOMER</th><th>DEVICE</th><th>SERVICE</th><th>ESTIMATE</th><th>STATUS / UPDATE</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><b>#PC-@r.Id.ToString("D4")</b><small class="d-block muted">@r.Customer?.FullName · @r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></td><td>@r.PhoneBrand @r.PhoneModel</td><td>@r.RepairService?.Name</td><td>PKR @r.EstimatedCost.ToString("N0")</td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@r.Id"/><select name="status" class="form-select form-select-sm status-select">@foreach(var s in new[]{"Submitted","Diagnosing","Awaiting Approval","In Repair","Completed","Rejected"}){<option selected="@(r.Status == s)" value="@s">@s</option>}</select><button class="btn btn-sm btn-dark">Save</button></form></td></tr>}</tbody></table></div>
</div></div></div>
