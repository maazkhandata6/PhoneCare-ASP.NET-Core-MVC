@model IEnumerable<Payment>
@{ViewData["Title"]="Payments";}
<div class="dashboard-shell"><div class="container"><div class="dash-heading"><div><div class="eyebrow">PAYMENT REGISTER</div><h1>Payments & <em>invoices.</em></h1><p class="muted">Record payments against repair requests.</p></div><a class="btn btn-outline-secondary rounded-pill" asp-action="Index">Dashboard</a></div><div class="panel mb-3"><h4>Record payment</h4><form asp-action="RecordPayment" method="post" class="row g-2 mt-2"><div class="col-md-3"><input name="repairRequestId" type="number" min="1" class="form-control" placeholder="Repair ID" required/></div><div class="col-md-3"><input name="amount" type="number" min="1" step=".01" class="form-control" placeholder="Amount PKR" required/></div><div class="col-md-3"><select name="method" class="form-select"><option>Cash</option><option>Bank Transfer</option><option>Card</option><option>Other</option></select></div><div class="col-md-3"><button class="btn btn-brand w-100">Record payment</button></div></form></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>RECEIPT</th><th>REPAIR</th><th>CUSTOMER</th><th>AMOUNT</th><th>METHOD</th><th>DATE</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Reference</td><td>#PC-@p.RepairRequestId</td><td>@p.RepairRequest?.Customer?.FullName</td><td>PKR @p.Amount.ToString("N0")</td><td>@p.Method</td><td>@p.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></div></div></div>