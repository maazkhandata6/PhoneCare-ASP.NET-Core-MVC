@model IEnumerable<PhoneBrand>
@{ViewData["Title"]="Phone catalog";}
<div class="dashboard-shell"><div class="container"><div class="dash-heading"><div><div class="eyebrow">DEVICE CATALOG</div><h1>Phone <em>catalog.</em></h1><p class="muted">Manage supported brands and models.</p></div><a class="btn btn-outline-secondary rounded-pill" asp-action="Index">Dashboard</a></div><div class="row g-3"><div class="col-lg-4"><div class="panel"><h4>Add brand</h4><form asp-action="AddBrand" method="post"><input name="name" class="form-control my-3" required maxlength="60" placeholder="Brand name"/><button class="btn btn-brand w-100">Add brand</button></form></div></div><div class="col-lg-8"><div class="panel"><h4>Brands and models</h4>@foreach(var b in Model){<div class="py-3 border-bottom"><b>@b.Name</b><div class="small muted my-2">@string.Join(", ",b.Models.Select(x=>x.Name))</div><form asp-action="AddModel" method="post" class="d-flex gap-2"><input type="hidden" name="phoneBrandId" value="@b.Id"/><input name="name" class="form-control form-control-sm" required placeholder="Model name"/><button class="btn btn-sm btn-dark">Add model</button></form></div>}</div></div></div></div></div>