@model RepairRequest
@{ ViewData["Title"] = "Repair details"; }
<div class="dashboard-shell"><div class="container"><div class="dash-heading"><div><div class="eyebrow">REPAIR / #PC-@Model.Id.ToString("D4")</div><h1>Repair <em>details.</em></h1><p class="muted">Submitted @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p></div><a class="btn btn-outline-secondary rounded-pill" asp-controller="Customer" asp-action="Index">Back to dashboard</a></div>
<div class="panel detail-panel"><div class="d-flex justify-content-between flex-wrap gap-3"><div><span class="soft-label">CURRENT STATUS</span><h3 class="mt-2">@Model.Status</h3></div><span class="status status-@Model.Status.ToLower().Replace(" ","-") align-self-start">@Model.Status</span></div><hr/><div class="row g-4"><div class="col-md-6"><small class="muted">DEVICE</small><h5>@Model.PhoneBrand @Model.PhoneModel</h5></div><div class="col-md-6"><small class="muted">SERVICE</small><h5>@Model.RepairService?.Name</h5></div><div class="col-md-6"><small class="muted">ESTIMATED COST</small><h4 class="price">PKR @Model.EstimatedCost.ToString("N0")</h4></div><div class="col-md-6"><small class="muted">CUSTOMER</small><h5>@Model.Customer?.FullName</h5></div><div class="col-12"><small class="muted">PROBLEM DESCRIPTION</small><p>@Model.ProblemDescription</p></div></div><div class="estimate-note"><i class="bi bi-info-circle"></i><span><b>Estimate only</b><small>Final repair cost is confirmed after technician diagnosis and customer approval.</small></span></div></div></div></div>
